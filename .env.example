# ValuSense — environment configuration
# Copy this file to `.env` and fill in the values you have.
# `.env` is gitignored — never commit real keys.
# On Streamlit Community Cloud, use Settings -> Secrets instead (same key names).

# AI Assistant — primary provider (Groq)
GROQ_API_KEY=

# AI Assistant — automatic fallback providers (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
